{
  "name": "AstroManager",
  "short_name": "AstroManager",
  "description": "DeepSky Sessions, Targets, Galerie und FITS-Viewer als installierbare Web-App.",
  "start_url": "/#gallery",
  "scope": "/",
  "display": "standalone",
  "background_color": "#031127",
