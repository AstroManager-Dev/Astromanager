#!/usr/bin/env python3
import re
import sqlite3
import sys

DB_PATH = sys.argv[1] if len(sys.argv) > 1 else "/runtime/pipeline.db"

def norm(value: str) -> str:
    v = (value or "").strip().lower()
    v = re.sub(r"[^a-z0-9]+", "", v)
    return v

conn = sqlite3.connect(DB_PATH)
cur = conn.cursor()

target_cols = [r[1] for r in cur.execute("PRAGMA table_info(targets)").fetchall()]
session_target_cols = [r[1] for r in cur.execute("PRAGMA table_info(session_targets)").fetchall()]

has_slug = "slug" in target_cols
has_canonical = "canonical_name" in target_cols
has_display = "display_name" in target_cols
has_updated = "updated_at" in target_cols

rows = cur.execute("""
    SELECT id,
           COALESCE(canonical_name, ''),
           COALESCE(slug, ''),
           COALESCE(display_name, '')
    FROM targets
    ORDER BY id
""").fetchall()

groups = {}
for rid, canonical_name, slug, display_name in rows:
    key = norm(canonical_name) or norm(slug) or norm(display_name)
    if not key:
        key = f"legacytarget{rid}"
    groups.setdefault(key, []).append({
        "id": rid,
        "canonical_name": canonical_name,
        "slug": slug,
        "display_name": display_name,
    })

def score_target(t):
    score = 0
    cn = (t["canonical_name"] or "").strip()
    sg = (t["slug"] or "").strip()
    dn = (t["display_name"] or "").strip()

    if cn and " " not in cn:
        score += 50
    if sg and " " not in sg:
        score += 40
    if dn and dn.upper().startswith(("NGC", "IC", "M")):
        score += 10
    score -= t["id"] * 0.0001
    return score

merged = 0
for key, items in groups.items():
    if len(items) < 2:
        continue

    items = sorted(items, key=score_target, reverse=True)
    keep = items[0]
    drop = items[1:]

    keep_id = keep["id"]

    best_canonical = keep["canonical_name"] or keep["slug"] or keep["display_name"]
    best_slug = keep["slug"] or keep["canonical_name"]
    best_display = keep["display_name"] or keep["canonical_name"] or keep["slug"]

    for d in drop:
        if not best_canonical:
            best_canonical = d["canonical_name"] or d["slug"] or d["display_name"]
        if not best_slug:
            best_slug = d["slug"] or d["canonical_name"]
        if not best_display:
            best_display = d["display_name"] or d["canonical_name"] or d["slug"]

        if "target_id" in session_target_cols:
            cur.execute(
                "UPDATE session_targets SET target_id=? WHERE target_id=?",
                (keep_id, d["id"])
            )

        cur.execute("DELETE FROM targets WHERE id=?", (d["id"],))
        merged += 1

    set_parts = []
    params = []

    if has_canonical:
        set_parts.append("canonical_name=?")
        params.append(best_canonical)
    if has_slug:
        set_parts.append("slug=?")
        params.append(best_slug)
    if has_display:
        set_parts.append("display_name=?")
        params.append(best_display)
    if has_updated:
        set_parts.append("updated_at=datetime('now')")

    if set_parts:
        params.append(keep_id)
        cur.execute(f"UPDATE targets SET {', '.join(set_parts)} WHERE id=?", params)

conn.commit()
print(f"OK merged_duplicates={merged}")
conn.close()
